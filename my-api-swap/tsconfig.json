{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",

    "rootDir": "./",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["node"],

    "sourceMap": true
  },

  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}